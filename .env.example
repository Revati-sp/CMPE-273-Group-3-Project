# Copy to .env (`make env` does this and generates JWT_SECRET for you).

# Shared signing key for JWTs. Must be at least 32 characters.
JWT_SECRET=replace-me-with-at-least-32-random-characters

POSTGRES_USER=engagehub
POSTGRES_PASSWORD=engagehub-local-only

# Demo data. Set SEED_DEMO_DATA=false outside a demo: DEMO_PASSWORD is public knowledge.
SEED_DEMO_DATA=true
DEMO_PASSWORD=engagehub-demo

GRAFANA_ADMIN_PASSWORD=engagehub-local-only

LOG_LEVEL=INFO
OTEL_ENABLED=true
LLM_PROVIDER=rules

# Enables POST /dev/fake-replies on chat-service (used by the replay demo screen).
ENABLE_DEV_ENDPOINTS=true

# Host ports (localhost only). Chosen to avoid the common 3000/8080/9090.
GATEWAY_PORT=18080
GRAFANA_PORT=13000
PROMETHEUS_PORT=19090
JAEGER_PORT=16686
